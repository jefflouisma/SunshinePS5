# Build-time generator: embeds the allowlisted static web app into the core as
# immutable byte tables (core/web/assets.h). The build fails when the webapp
# directory and the allowlist disagree, when a page or module references a
# file that is not embedded, when any asset names an absolute http(s) URL
# (the app must stay usable offline) or when an asset exceeds the bounded
# management response capacity.
# Usage: cmake -DSOURCE_DIR=... -DASSETS=a|b -DOUTPUT=... -DLIMIT=N -P embed-webapp.cmake
cmake_minimum_required(VERSION 3.25)
foreach(required IN ITEMS SOURCE_DIR ASSETS OUTPUT LIMIT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "embed-webapp.cmake requires -D${required}")
    endif()
endforeach()
string(REPLACE "|" ";" assets "${ASSETS}")

file(GLOB present RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*")
# Hidden files (e.g. macOS .DS_Store) are never embedded or served.
list(FILTER present EXCLUDE REGEX "^\\.")
set(expected ${assets})
list(SORT present)
list(SORT expected)
if(NOT present STREQUAL expected)
    message(FATAL_ERROR "webapp/ must contain exactly the embedded allowlist.\n"
        "  present:   ${present}\n  allowlist: ${expected}")
endif()

set(arrays "")
set(table "")
set(index 0)
foreach(name IN LISTS assets)
    set(path "${SOURCE_DIR}/${name}")
    file(READ "${path}" content)
    if(content MATCHES "https?://")
        message(FATAL_ERROR "${name} names an absolute http(s) URL; assets must stay local")
    endif()
    if(name MATCHES "\\.html$")
        set(type "text/html; charset=utf-8")
        string(REGEX MATCHALL "(src|href)=\"[^\"]*\"" references "${content}")
        foreach(reference IN LISTS references)
            string(REGEX REPLACE "^(src|href)=\"(.*)\"$" "\\2" target "${reference}")
            string(REGEX REPLACE "^/" "" local "${target}")
            if(NOT target MATCHES "^/" OR NOT local IN_LIST assets)
                message(FATAL_ERROR "${name} references ${target}, which is not an embedded asset")
            endif()
        endforeach()
    elseif(name MATCHES "\\.js$")
        set(type "text/javascript; charset=utf-8")
        string(REGEX MATCHALL "[\"'`]\\./[A-Za-z0-9_-]+\\.js[\"'`]" references "${content}")
        foreach(reference IN LISTS references)
            string(REGEX REPLACE "^.\\./(.*).$" "\\1" module "${reference}")
            if(NOT module IN_LIST assets)
                message(FATAL_ERROR "${name} imports ./${module}, which is not an embedded asset")
            endif()
        endforeach()
        if(content MATCHES "import\\([^\"']")
            message(FATAL_ERROR "${name} uses a computed dynamic import; name modules literally")
        endif()
    elseif(name MATCHES "\\.css$")
        set(type "text/css; charset=utf-8")
    else()
        message(FATAL_ERROR "No content type is approved for webapp/${name}")
    endif()
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_size)
    math(EXPR size "${hex_size} / 2")
    if(size GREATER LIMIT)
        message(FATAL_ERROR "${name} is ${size} bytes; the response limit is ${LIMIT}")
    endif()
    string(APPEND arrays "static const uint8_t asset_${index}[] = {\n")
    set(offset 0)
    while(offset LESS hex_size)
        string(SUBSTRING "${hex}" ${offset} 32 line)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," line "${line}")
        string(APPEND arrays "    ${line}\n")
        math(EXPR offset "${offset} + 32")
    endwhile()
    # The trailing terminator keeps empty assets valid C; it is never served.
    string(APPEND arrays "    0};\n")
    string(APPEND table "    {\"/${name}\", \"${type}\", asset_${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}.tmp" "/* Generated by cmake/embed-webapp.cmake from webapp/. Do not edit. */\n"
    "#include \"web/assets.h\"\n\n${arrays}\nconst sp5_web_asset sp5_web_assets[] = {\n${table}};\n"
    "const size_t sp5_web_asset_count = sizeof(sp5_web_assets) / sizeof(sp5_web_assets[0]);\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
