            "width": {
              "anyOf": [
                {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "anyOf": [
                {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fps_numerator": {
              "anyOf": [
                {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fps_denominator": {
              "anyOf": [
                {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                },
                {
