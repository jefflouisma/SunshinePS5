{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunshineps5.local/schemas/1.1.0/host-observation.schema.json",
  "title": "Version 1.1 host observation (backward compatible with 1.0)",
  "description": "Streamed host-authority frame/input boundary records. Frame drops remain separate from client packet/frame loss. A network acknowledgement is not a console delivery observation.",
  "$comment": "Consumers correlate session/frame/event IDs and source_clock.id with clock_domain, check monotonic timestamps within each epoch, authenticate input provenance, and verify platform delivery documentation. Nested evidence must belong to this session/frame/event. Schemas do not attest hardware provenance; synthetic_fixture records cannot close console acceptance gates. Coverage buffers are bounded and overflow must invalidate coverage rather than silently omit gaps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "session_id",
    "provenance",
    "source",
    "kind",
    "clock_domain",
    "source_clock",
    "observed_at",
    "population",
    "coverage",
    "validity",
    "reason",
    "artifact_refs",
    "measurements"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "id": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/id"
    },
    "session_id": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/id"
    },
    "provenance": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/provenance"
    },
    "source": {
      "const": "host_pipeline"
    },
    "kind": {
      "enum": [
        "frame",
        "input",
        "metrics_coverage"
      ]
    },
    "frame_id": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
    },
    "event_id": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/id"
    },
    "controller_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "boundary": {
      "enum": [
        "captured",
        "encode_accepted",
        "encode_completed",
        "network_submitted",
        "host_dropped",
        "host_received",
        "console_delivered",
        "delivery_failed",
        "metrics_enabled",
        "metrics_disabled",
        "coverage_invalidated"
      ]
    },
    "drop_reason": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/reason"
    },
    "authenticated": {
      "type": "boolean"
    },
    "delivery_boundary": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/reason"
    },
    "clock_domain": {
      "anyOf": [
        {
          "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_clock": {
      "anyOf": [
        {
          "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/clock"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "anyOf": [
        {
          "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
        },
        {
          "type": "null"
        }
      ]
    },
    "population": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/population"
    },
    "coverage": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/coverage"
    },
    "validity": {
      "enum": [
        "valid",
        "unavailable",
        "invalid"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_refs": {
      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/artifact_refs"
    },
    "measurements": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host_version",
            "firmware_version",
            "client_name",
            "codec",
            "delivery_boundary",
            "width",
            "height",
            "fps_numerator",
            "fps_denominator",
            "requested_bitrate_kbps",
            "chosen_bitrate_kbps",
            "dynamic_range"
