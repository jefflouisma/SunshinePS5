                }
              ]
            },
            "dynamic_range": {
              "enum": [
                "unknown",
                "sdr",
                "hdr_pq_bt2020"
              ]
            }
          }
        },
        "summaries": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "window",
              "population",
              "median",
              "p95",
              "p99"
            ],
            "properties": {
              "channel": {
                "enum": [
