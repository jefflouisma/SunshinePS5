                  "encode",
                  "packetize",
                  "send",
                  "full_pipeline",
                  "input_delivery"
                ]
              },
              "window": {
                "enum": [
                  "whole_session",
                  "last_10_seconds"
                ]
              },
              "population": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "seen",
                  "represented",
                  "overflow",
                  "missing",
                  "failed_deliveries"
                ],
                "properties": {
                  "seen": {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  },
                  "represented": {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  },
                  "overflow": {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  },
                  "missing": {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  },
                  "failed_deliveries": {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  }
                }
              },
              "median": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value_us",
                  "lower_bound_us",
                  "population",
                  "validity",
                  "reason"
                ],
                "properties": {
                  "value_us": {
                    "anyOf": [
                      {
                        "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lower_bound_us": {
                    "anyOf": [
                      {
                        "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "population": {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  },
                  "validity": {
                    "enum": [
                      "valid",
                      "unavailable",
                      "invalid"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "validity": {
                          "const": "valid"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "value_us": {
                          "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                        },
                        "lower_bound_us": {
                          "type": "null"
                        },
                        "reason": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "value_us": {
                          "type": "null"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              },
              "p95": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value_us",
                  "lower_bound_us",
                  "population",
                  "validity",
                  "reason"
                ],
                "properties": {
                  "value_us": {
                    "anyOf": [
                      {
                        "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lower_bound_us": {
                    "anyOf": [
                      {
                        "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "population": {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  },
                  "validity": {
                    "enum": [
                      "valid",
                      "unavailable",
                      "invalid"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "validity": {
                          "const": "valid"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "value_us": {
                          "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                        },
                        "lower_bound_us": {
                          "type": "null"
                        },
                        "reason": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "value_us": {
                          "type": "null"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              },
              "p99": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value_us",
                  "lower_bound_us",
                  "population",
                  "validity",
                  "reason"
                ],
                "properties": {
                  "value_us": {
                    "anyOf": [
                      {
                        "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lower_bound_us": {
                    "anyOf": [
                      {
                        "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "population": {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  },
                  "validity": {
                    "enum": [
                      "valid",
                      "unavailable",
                      "invalid"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "validity": {
                          "const": "valid"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "value_us": {
                          "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                        },
                        "lower_bound_us": {
                          "type": "null"
                        },
                        "reason": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "value_us": {
                          "type": "null"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "retained": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frames",
            "inputs"
          ],
          "properties": {
            "frames": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "first_us",
                "last_us",
                "records"
              ],
              "properties": {
                "first_us": {
                  "anyOf": [
                    {
                      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "last_us": {
                  "anyOf": [
                    {
                      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "records": {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                }
              }
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "first_us",
                "last_us",
                "records"
              ],
              "properties": {
                "first_us": {
                  "anyOf": [
                    {
                      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "last_us": {
                  "anyOf": [
                    {
                      "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "records": {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                }
              }
            }
          }
        },
        "continuous": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame_outcomes",
            "encoded_bytes",
            "network_bytes",
            "client_lost_packets",
            "client_recovery_requests",
            "start_us",
            "end_us",
            "validity",
            "reason",
            "encoded_bitrate_bps",
            "network_throughput_bps",
            "frame_rate_millihz"
          ],
          "properties": {
            "frame_outcomes": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
              }
            },
            "encoded_bytes": {
              "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
            },
            "network_bytes": {
              "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
            },
            "client_lost_packets": {
              "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
            },
            "client_recovery_requests": {
              "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
            },
            "start_us": {
              "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
            },
            "end_us": {
              "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
            },
            "validity": {
              "enum": [
                "valid",
                "invalid",
                "unavailable"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "encoded_bitrate_bps": {
              "anyOf": [
                {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                },
                {
                  "type": "null"
                }
              ]
            },
            "network_throughput_bps": {
              "anyOf": [
                {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                },
                {
                  "type": "null"
                }
              ]
            },
            "frame_rate_millihz": {
              "anyOf": [
                {
                  "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "allocated_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 83886080
        },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_us",
            "durations_us",
            "flags"
          ],
          "properties": {
            "observed_us": {
              "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
            },
            "durations_us": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "anyOf": [
                  {
                    "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "flags": {
              "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validity": {
            "const": "valid"
          }
        }
      },
      "then": {
        "properties": {
          "clock_domain": {
            "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/id"
          },
          "source_clock": {
            "allOf": [
              {
                "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/clock"
              },
              {
                "properties": {
                  "validity": {
                    "const": "valid"
                  }
                }
              }
            ]
          },
          "observed_at": {
            "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/counter"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/reason"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "observed_at": {
            "type": "null"
          },
          "reason": {
            "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/reason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "frame"
          }
        }
      },
      "then": {
        "required": [
          "frame_id",
          "boundary"
        ],
        "properties": {
          "boundary": {
            "enum": [
              "captured",
              "encode_accepted",
              "encode_completed",
              "network_submitted",
              "host_dropped"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "event_id"
              ]
            },
            {
              "required": [
                "controller_id"
              ]
            },
            {
              "required": [
                "delivery_boundary"
              ]
            },
            {
              "required": [
                "authenticated"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "input"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "controller_id",
          "boundary",
          "authenticated"
        ],
        "properties": {
          "boundary": {
            "enum": [
              "host_received",
              "console_delivered",
              "delivery_failed"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "frame_id"
              ]
            },
            {
              "required": [
                "drop_reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "metrics_coverage"
          }
        }
      },
      "then": {
        "required": [
          "boundary"
        ],
        "properties": {
          "boundary": {
            "enum": [
              "metrics_enabled",
              "metrics_disabled",
              "coverage_invalidated"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "frame_id"
              ]
            },
            {
              "required": [
                "event_id"
              ]
            },
            {
              "required": [
                "controller_id"
              ]
            },
            {
              "required": [
                "delivery_boundary"
              ]
            },
            {
              "required": [
                "authenticated"
              ]
            },
            {
              "required": [
                "drop_reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "boundary": {
            "const": "host_dropped"
          }
        }
      },
      "then": {
        "required": [
          "drop_reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "drop_reason"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "boundary": {
            "const": "console_delivered"
          }
        }
      },
      "then": {
        "required": [
          "delivery_boundary"
        ],
        "properties": {
          "authenticated": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "boundary": {
            "const": "delivery_failed"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "$ref": "https://sunshineps5.local/schemas/1.0.0/evidence.schema.json#/$defs/reason"
          }
        }
      }
    }
  ]
}
